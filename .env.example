# =====================================================================
#  KN Softic – WhatsApp Cloud API Manager
#  Copy to .env, then: php artisan key:generate
#  NEVER commit .env. WhatsApp credentials are NOT stored here — they are
#  entered per number on the "WhatsApp Accounts" page and encrypted in MySQL.
# =====================================================================

APP_NAME="KN Softic WhatsApp Manager"
APP_ENV=local                 # production on the VPS
APP_KEY=                      # php artisan key:generate — BACK IT UP: losing it makes saved tokens unreadable
APP_DEBUG=true                # false in production
APP_URL=http://127.0.0.1:8000 # https://your-domain.com in production (Meta needs HTTPS)
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single              # daily in production
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug               # warning in production

# ---- Database (MySQL 8 / MariaDB 10.4+) -------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kn_whatsapp
DB_USERNAME=root
DB_PASSWORD=

# ---- Sessions (secure defaults) -------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false   # true in production (HTTPS only)
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ---- Queue / cache / files ------------------------------------------
QUEUE_CONNECTION=database     # redis recommended on the VPS
CACHE_STORE=database
FILESYSTEM_DISK=local         # media is stored on the PRIVATE local disk

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Mail (password reset emails) ------------------------------------
MAIL_MAILER=log               # smtp in production
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Real-time (Laravel Reverb) ---------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=                # php artisan reverb:install fills these
REVERB_APP_KEY=
REVERB_APP_SECRET=            # server-side only, never exposed to the browser
REVERB_HOST="localhost"       # your-domain.com in production
REVERB_PORT=8080              # 443 in production (behind Nginx)
REVERB_SCHEME=http            # https in production
# Where the Reverb process itself listens (behind Nginx in production):
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ---- First Super Admin (php artisan db:seed) ----------------------------
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=               # leave empty → a random password is printed once

# ---- WhatsApp Cloud API defaults ---------------------------------------
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_APPSECRET_PROOF=true
WHATSAPP_HTTP_TIMEOUT=30
WHATSAPP_QUEUE=default
WHATSAPP_WEBHOOK_RATE_LIMIT=1200      # webhook requests / minute / number
WHATSAPP_WEBHOOK_RETENTION_DAYS=30    # delete processed raw webhook payloads after N days
WHATSAPP_SEND_RATE_LIMIT=60           # dashboard sends / minute / user
WHATSAPP_MEDIA_DISK=local
